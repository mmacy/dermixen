# Discogs OAuth consumer keys for tools/discogs_release.py and tools/discogs_year.py.
# Copy this file to .env, which git ignores, and fill in the two values from
# https://www.discogs.com/settings/developers. Without them the tools make no
# API requests and resolve releases from the collection export alone.
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
DISCOGS_REQUEST_TOKEN_URL=https://api.discogs.com/oauth/request_token
DISCOGS_AUTHORIZE_URL=https://www.discogs.com/oauth/authorize
DISCOGS_ACCESS_TOKEN_URL=https://api.discogs.com/oauth/access_token
